# Terraform State (ローカル管理 - 機密情報を含む)
# state rm / import 前に手動退避したバックアップも確実に除外する
terraform.tfstate*

# 実際の変数値 (機密情報を含む)
terraform.tfvars

# Terraform キャッシュ (.terraform.lock.hcl はプロバイダーバージョンを固定するためリポジトリ管理)
.terraform/

# archive_file が生成する Lambda 関数の zip (lambda/code_runner/ruby から毎回作り直される)
.build/

# クラッシュログ
crash.log
crash.*.log

# Override ファイル
override.tf
override.tf.json
*_override.tf
*_override.tf.json
